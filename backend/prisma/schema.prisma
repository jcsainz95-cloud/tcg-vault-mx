// Prisma schema — Marketplace TCG con Bóveda (Pokémon, México)
// Propiedad: backend. Modelo de datos según ARCHITECTURE.md §3.
// Convención de dinero: enteros en centavos MXN (*Cents). No hay wallet/saldo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================= ENUMS =============================

enum Role {
  customer
  vault_operator
  super_admin
}

enum Locale {
  es
  en
}

enum UserStatus {
  active
  blocked
  // v1.3.1 (M-15): cuenta soft-deleted/anonimizada. Login (local y Google) la rechaza con
  // 403 USER_BLOCKED. Solo se alcanza vía DELETE /admin/users/:id (soft); PATCH .../status no.
  deleted
}

// v1.3.1 (M-14): naturaleza de la regla de precio de buylist por rareza.
// fixed = monto MX$ en centavos; pct = % de la referencia de mercado. Reemplaza BuylistCategory.
enum BuylistRuleMode {
  fixed
  pct
}

enum ProductType {
  graded
  sealed
  raw
}

// v1.1 (M-1): reducido a un ÚNICO valor NM (se eliminan LP|MP|HP|DMG). El raw se
// opera únicamente en Near Mint en todo el marketplace (ARCHITECTURE §3.5, §11).
enum RawCondition {
  NM
}

// v1.6-finish (M-18): acabado/versión de carta. Valores canónicos derivados de las
// llaves de `tcgplayer.prices` (mapeo en ARCHITECTURE §3.7):
//   normal→normal, reverseHolofoil→reverse_holo, holofoil→holofoil,
//   1stEditionHolofoil→first_edition_holofoil. graded/sealed = normal siempre.
enum Finish {
  normal
  reverse_holo
  holofoil
  first_edition_holofoil
}

// v1.1 (M-2): subtipo opcional del producto sellado (solo productType=sealed).
// v1.39 (M-39, P-38, §4.34c): +`upc` (Ultra Premium Collection) y +`collection` (colecciones/cajas
// especiales: Premium/Special Collection, V/ex Box, colecciones promo). `ALTER TYPE ADD VALUE` es
// aditivo (se APENDA al final para casar con el orden de la migración); ningún valor previo cambia.
enum SealedSubtype {
  box
  etb
  bundle
  tin
  blister
  upc
  collection
}

// v1.39 (M-39, P-38, §4.34b): tipo de grupo TCGCSV asociado a un set. `set_main` = grupo principal
// (booster box/ETB/bundle…); `promo_collection` = grupo APARTE de promo/colección (blísters/tins/
// colecciones promo, incl. Mega Evolution). Un set tiene 1 `set_main` + N `promo_collection`.
enum SealedGroupKind {
  set_main
  promo_collection
}

// v1.23-sealed-sales (M-28): condición SIMPLE del sellado, visible al comprador.
// `mint` = «Como nueva» · `minor_box_damage` = «Detalle menor en caja». Labels legibles
// en i18n del front (no en la API). NO altera el precio derivado (el spread es por
// presentación, no por condición); para descontar una caja con detalle el admin usa el
// override por pieza. App-requerido para productType='sealed' (default mint); null para
// raw/graded (regla de aplicación, no constraint de BD). ARCHITECTURE §4.23i / §11 (M-28).
enum SealedCondition {
  mint
  minor_box_damage
}

// v1.1 (M-4): proveedor de autenticación del usuario (email/contraseña o Google).
enum AuthProvider {
  local
  google
}

enum GradingCompany {
  PSA
  CGC
}

enum OwnerType {
  platform
  customer
}

enum OwnershipStatus {
  pending
  settled
}

enum InventoryStatus {
  in_stock
  listed
  reserved
  in_custody
  picking
  shipped
  delivered
  lost
  damaged
  withdrawn
}

enum VaultZone {
  platform_stock
  customer_custody
}

enum OrderStatus {
  pending
  settled
  failed
  refunded
  chargeback
}

// v1.21-guest-checkout (M-25): destino del pedido. `vault` = comportamiento actual (la carta
// entra a la bóveda del comprador con cuenta); `direct_ship` = envío directo a domicilio, única
// ruta disponible para un pedido de INVITADO (la bóveda exige cuenta, PROJECT §J).
// API_CONTRACT §4-G.10 / ARCHITECTURE §4.21.
enum FulfillmentMode {
  vault
  direct_ship
}

enum ShipmentStatus {
  solicitado
  picking
  guia
  enviado
  entregado
  cancelado
}

enum SellRequestStatus {
  cotizada
  recibida
  verificacion
  aprobada
  pagada
  rechazada
  abandonada
}

enum SellItemStatus {
  cotizada
  precio_pendiente
  recibida
  verificacion
  aprobada
  ajustada
  rechazada
  pagada
  convertida_inventario
}

enum BuylistCategory {
  comun
  reverse_holo
  ex_plus
}

enum DisputeStatus {
  abierta
  en_revision
  resuelta_recompra
  rechazada
}

enum PriceSource {
  pokemontcg_io
  pokemonpricetracker
  poketrace
  manual
  // v1.19-sealed-tcgcsv (M-23): referencia de mercado del SELLADO vía TCGCSV
  // (espejo diario de precios de TCGplayer). ARCHITECTURE §4.19.
  tcgcsv
  // v1.29 (M-31, §4.27f): PRIMARIO de precio de SINGLES por variante (por CardProduct+acabado),
  // leído del `marketPrice` de TCGCSV por `subTypeName`. Distinto de `tcgcsv` (sellado, sub-tipo
  // Normal). PPT/pokemontcg.io quedan como FALLBACK. Ver ARCHITECTURE §4.27.
  tcgcsv_singles
}

// v1.29 (M-31, ARCHITECTURE §4.27b): naturaleza del producto TCGplayer bajo una MISMA carta de
// colección. Una `Card` (identidad = externalId pokemontcg.io) agrupa N `CardProduct`, uno por
// `productId`. `set_base` es el producto de set «normal» (el que hoy ancla `Card.tcgplayerId`);
// `deck_exclusive`/`promo` son productos VENDIBLES/COTIZABLES aparte con su propio precio;
// `other` = no clasificable por nombre (fail-safe; se trata como set_base para el binder).
enum CardProductKind {
  set_base
  deck_exclusive
  promo
  other
}

enum KycStatus {
  none
  pending
  verified
  rejected
}

enum AcquisitionType {
  aportacion_en_especie
  buylist
  compra
}

enum CfdiStatus {
  registrado
  no_aplica
}

enum MovementReason {
  alta
  move
  sale
  settle
  chargeback_return
  withdrawal
  lost
  damaged
  buylist_convert
  // v1.20-master-set-everywhere (M-24): ajuste por LEVANTAMIENTO FÍSICO desde el binder M1
  // (POST /admin/inventory/adjustments). El historial de la pieza distingue un ajuste de
  // operador (`adjustment`) de un `mark` normal (`lost`/`damaged`) o un retiro (`withdrawal`).
  adjustment
}

// v1.20-master-set-everywhere (M-24): motivo OBLIGATORIO del ajuste de inventario por
// levantamiento físico (ARCHITECTURE §4.20e). `encontrada` crea pieza(s); `perdida`/`danada`
// → lost/damaged (flujo de reposición/merma); `error_captura` → withdrawn SIN semántica de
// pérdida (la pieza nunca existió físicamente; la distinción vive aquí, no en InventoryStatus).
enum AdjustmentReason {
  encontrada
  perdida
  danada
  error_captura
}

enum PendingPriceContext {
  catalog
  portfolio
  buylist
  inventory
}

enum PendingPriceStatus {
  open
  resolved
}

// v1.5 (M-17): tipo de token de un solo uso para los flujos self-service por correo.
// email_verification (24h) / password_reset (1h). El token en claro (32 bytes aleatorios)
// viaja SOLO por correo; en BD vive su SHA-256 (AuthToken.tokenHash). ARCHITECTURE §3.2/§4.11.
enum AuthTokenType {
  email_verification
  password_reset
}

// ============================= USER / KYC / BILLING =============================

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  // v1.1 (M-3): nullable — null para cuentas creadas SOLO con Google (sin contraseña).
  passwordHash       String?
  role               Role         @default(customer)
  name               String
  phone              String?
  locale             Locale       @default(es)
  status             UserStatus   @default(active)
  // v1.1 (M-4..M-7): campos de auth Google. `role` SIEMPRE server-side (nunca del token).
  authProvider       AuthProvider @default(local)
  googleId           String?      @unique
  emailVerified      Boolean      @default(false)
  avatarUrl          String?
  // v1.3.1 (M-15): gestión de cuenta por admin (M6).
  // `mustChangePassword` lo activa el reset admin (opcional de consumir por el front).
  // `tokenVersion` se INCREMENTA en reset/soft-delete: el JWT lo lleva y el guard rechaza
  // los tokens (access/refresh) con versión previa → revoca sesiones vivas.
  deletedAt          DateTime?
  anonymizedAt       DateTime?
  mustChangePassword Boolean      @default(false)
  tokenVersion       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  kycProfile                 KycProfile?
  billingProfile             BillingProfile?
  addresses                  Address[]
  orders                     Order[]
  shipmentRequests           ShipmentRequest[]
  sellRequests               SellRequest[]
  disputes                   Dispute[]
  ownedItems                 InventoryItem[]             @relation("OwnerUser")
  portfolioSnapshots         PortfolioSnapshot[]
  // v1.5 (M-17): tokens de verificación de correo / reset de contraseña (un solo uso, hash en BD).
  authTokens                 AuthToken[]
  // v1.23-sealed-sales (M-28): suscripciones restock del usuario (FK opcional; onDelete SetNull).
  sealedRestockSubscriptions SealedRestockSubscription[]

  @@index([role])
  @@index([status])
}

model KycProfile {
  id                         String    @id @default(uuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName                  String?
  // PII cifrada en reposo (AES-256-GCM, formato `v1:iv:tag:ct`). Ver PiiCryptoService.
  rfcEnc                     String?
  clabeEnc                   String?
  // Blind index (HMAC-SHA256) de la CLABE normalizada: permite el match "a nombre propio"
  // (CLABE_NOT_OWN_NAME) y detectar CLABE compartida entre cuentas SIN descifrar.
  clabeHmac                  String?
  ineFrontKey                String?
  ineBackKey                 String?
  kycStatus                  KycStatus @default(none)
  capPerRequestCentsOverride Int?
  capPerMonthCentsOverride   Int?
  verifiedBy                 String?
  verifiedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([clabeHmac])
}

model BillingProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // RFC cifrado en reposo (AES-256-GCM). Ver PiiCryptoService.
  rfcEnc        String
  razonSocial   String
  regimenFiscal String
  usoCfdi       String
  postalCode    String
  email         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1        String
  line2        String?
  neighborhood String?
  city         String
  state        String
  postalCode   String
  country      String   @default("MX")
  phone        String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ============================= CATALOG =============================

model CardSet {
  id            String   @id @default(uuid())
  externalId    String   @unique
  name          String
  series        String?
  releaseDate   String?
  printedTotal  Int?
  ptcgoCode     String?
  // WS-A fix-ppt (2026-08-19): setId del proveedor de PAGA PokemonPriceTracker (API v2). NO es el
  // `externalId` de pokemontcg.io (`sv8`): PPT NO reconoce ese id → `/api/v2/cards?setId=sv8` devolvía
  // `0 entradas` en TODOS los sets (causa raíz del "0 filas mapeadas"). Aquí se cachea el **GroupId
  // numérico de TCGplayer** (p. ej. "1407") — o el slug (`sv-prismatic-evolutions`) como respaldo — que
  // el `PptSetMapper` resuelve una vez desde `GET /api/v2/sets` empatando por nombre normalizado +
  // año de `releaseDate`. `null` = aún no mapeado (o no se encontró match; se loguea). El barrido de
  // precios de PPT usa ESTE valor como `setId`, jamás el `externalId`.
  pptSetId      String?
  // v1.36-sealed-alta (M-37, P-35, §4.32b): grupo TCGCSV CURADO por set. Resuelve el listado de
  // productos sellados de `GET /admin/inventory/sealed-catalog` (set → productos de la API). `null`
  // ⇒ fallback: `DISTINCT tcgplayerGroupId` de los items sellados YA mapeados del set. Solo lectura
  // de catálogo (resuelve el proxy); JAMÁS fija precio (money-safe). ARCHITECTURE §11 (M-37).
  tcgcsvGroupId Int?
  createdAt     DateTime @default(now())

  cards          Card[]
  // v1.9-set-chart (M-20): serie diaria del valor de mercado agregado del set (gráfica pública del hero).
  snapshots      SetValueSnapshot[]
  // v1.39-sealed-product-module (M-39, P-38): grupos TCGCSV enlazados al set (1 set → N grupos) y las
  // presentaciones selladas persistidas del set (catálogo de sellado, cura de raíz de SB-D5).
  sealedGroups   SealedSetGroup[]
  sealedProducts SealedProduct[]
}

// v1.39-sealed-product-module (M-39, P-38, §4.34b): tabla de enlace set → grupo TCGCSV. Rompe el
// modelo `1 set → 1 tcgcsvGroupId`: un set tiene 1 `set_main` (booster box/ETB/bundle…) + N
// `promo_collection` (blísters/tins/colecciones promo, incl. Mega Evolution). El sync la puebla por
// name-match SIN requerir un item sellado previo (rompe el círculo vicioso del hueco 1). `label` =
// nombre del grupo en TCGCSV (curación/observabilidad). `CardSet.tcgcsvGroupId` se conserva como
// puntero denormalizado al `set_main`; la FUENTE DE VERDAD del set_main pasa a ser esta tabla.
model SealedSetGroup {
  id               String          @id @default(uuid())
  setId            String
  set              CardSet         @relation(fields: [setId], references: [id], onDelete: Cascade)
  tcgplayerGroupId Int
  kind             SealedGroupKind
  label            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([setId, tcgplayerGroupId])
  @@index([setId])
}

// v1.39-sealed-product-module (M-39, P-38, §4.34a): entidad de CATÁLOGO de presentaciones selladas
// por set — fuente de verdad de la IDENTIDAD del sellado (cura de raíz de SB-D5: reemplaza la
// inferencia-por-hermanos y el ancla-a-single). Cada presentación (ETB, UPC, Booster Bundle, booster
// box, tin, blíster, colección) es una fila real descargada de TCGCSV por el sync, NO anclada a un
// single. `tcgplayerProductId` = clave de identidad (== productId TCGplayer; == clave de precio
// `sealed:tcg:<productId>`). `marketUsdCents` = CACHÉ de display/sugerencia (money-safe: null cuando
// TCGCSV no trae precio, JAMÁS 0); la autoridad de dinero sigue siendo la cadena H-1 `PriceReference`.
// `active=false` = soft-delete si desaparece de TCGCSV (nunca borrado duro: no rompe FKs de inventario).
model SealedProduct {
  id                 String          @id @default(uuid())
  setId              String
  set                CardSet         @relation(fields: [setId], references: [id], onDelete: Cascade)
  tcgplayerProductId Int             @unique
  tcgplayerGroupId   Int
  name               String
  cleanName          String?
  subtype            SealedSubtype
  // true = subtipo INFERIDO por heurística de nombre; false = curado por un humano (no lo pisa el sync).
  subtypeInferred    Boolean         @default(true)
  // presentación «cabecera» que el alta muestra primero (box/etb/upc/bundle); curable por pieza.
  isPrincipal        Boolean         @default(false)
  // de qué tipo de grupo provino (para separar «Del set» vs «Promos/colecciones» en la UI).
  origin             SealedGroupKind @default(set_main)
  imageUrl           String?
  marketUsdCents     Int?
  marketUpdatedAt    DateTime?
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inventoryItems InventoryItem[]

  @@index([setId])
  @@index([tcgplayerGroupId])
}

model Card {
  id                     String   @id @default(uuid())
  externalId             String   @unique
  setId                  String
  set                    CardSet  @relation(fields: [setId], references: [id])
  name                   String
  number                 String
  rarity                 String?
  supertype              String?
  subtypes               Json?
  imageSmallUrl          String?
  imageLargeUrl          String?
  tcgplayerId            String?
  // v1.6-finish (M-18): acabados en que existe esta carta, derivados de las llaves de
  // `tcgplayer.prices` al importar (ARCHITECTURE §3.7). SIGUE siendo 1 fila por externalId
  // (el @unique NO cambia; esto es un array en la MISMA fila). Filas históricas → [normal]
  // hasta el re-sync. Lista blanca contra la que el backend valida cualquier `finish` (SEC-A1).
  // v1.22-variantes-orden (§4.22a): la FUENTE es el SYNC DE CATÁLOGO y SOLO él (tcgplayer.prices
  // por llave presente ∪ cardmarket.prices.reverseHolo* por valor > 0). `price-ingest` NO escribe
  // esta columna (§4.15e derogada). Se almacena SIEMPRE en orden canónico FINISH_ORDER y nunca vacía.
  // v1.22-1 (M-27, §4.22g): DEJA de escribirse directamente. Pasa a ser una columna DERIVADA y
  // recomputable = orderFinishes(catalogFinishes ∪ pricedFinishesSnapshot) || ['normal']. Su ÚNICO
  // escritor es `catalog.FinishReconciler.reconcile(cardIds)`. Sigue siendo la lista blanca SEC-A1
  // y el universo de casillas del binder; su FORMA no cambia (Finish[], no vacía, FINISH_ORDER).
  availableFinishes      Finish[] @default([normal])
  // v1.22-1 (M-27, §4.22g) — INTERNA (no se expone en DTO). «Opinión del catálogo» = Señal A ∪ B
  // del último payload de pokemontcg.io (lo que devuelve `deriveAvailableFinishes(c)`), persistida
  // para SOBREVIVIR a un 502 de la fuente. La escribe `catalog-sync.upsertCards` con la semántica
  // null de §4.22a-4 (null ⇒ conserva; CREATE ⇒ derived ?? ['normal']). Backfill M-27: = availableFinishes.
  catalogFinishes        Finish[] @default([])
  // v1.22-1 (M-27, §4.22g) — INTERNA. Señal C = acabados que PPT reportó con market>0 para la carta,
  // filtrados a ALIAS VERIFICADO (candado 2). La escribe `price-ingest` por REEMPLAZO por carta en
  // una corrida EXITOSA (money-safe: no se toca ante fallo/0 filas). Alimenta la unión, NO es la
  // lista blanca (esa es availableFinishes).
  pricedFinishesSnapshot Finish[] @default([])
  // v1.26 (M-29, §4.24a) — INTERNA (no se expone en DTO). Afirmación ESTRUCTURAL AUTORITATIVA:
  // «¿en qué impresiones físicas se vende esta carta?» DETECTADA de TCGCSV (`subTypeName`), NUNCA
  // inferida de rareza/era ni de la presencia de una llave de precio. ANCLA/REEMPLAZA a
  // `catalogFinishes` como entrada del lado catálogo en la unión del reconciliador:
  //   availableFinishes := orderFinishes(structuralFinishes ∪ pricedFinishesSnapshot) || ['normal']
  // La escribe: (i) `catalog-sync.upsertCards` en CREATE como SEED (`derived ?? ['normal']`; UPDATE
  // NO la toca — pokemontcg.io no es autoridad estructural); (ii) el resolver TCGCSV de `importSet`
  // (first-import/`--force`) por REEMPLAZO SOLO para cartas joineadas (money-safe: una carta no
  // joineada conserva su valor previo). Una impresión aquí SIN PriceReference es «pendiente», nunca
  // dropeada. Backfill M-29: = availableFinishes.
  structuralFinishes     Finish[] @default([])
  // v1.29 (M-31, §4.28c) — rareza CANÓNICA derivada de `rarity` crudo por `normalizeRarity` en el
  // INGEST. `Card.rarity` CRUDO se conserva (procedencia); ESTE campo lo consumen precios (lookup de
  // reglas por rareza) y el admin (`groupBy(['rarityCanonical'])`). Nullable (backfill M-31). La
  // FORMA de las reglas es de dos ejes: rareza sale de la carta, finish del CardProduct (§4.28d).
  rarityCanonical        String?
  // v1.22-variantes-orden (M-26, §4.22b): claves DERIVADAS de `number` (String) para el ORDEN
  // NATURAL en BD. `number` sigue siendo la fuente de verdad; si divergen, se recalculan de él.
  // Puro numérico → numberSort = entero (clamp 999_999) y numberPrefix = ''. Con prefijo
  // alfabético (TG12/SV107) → numberPrefix = las letras y numberSort = 1_000_000 + parte numérica
  // (promos/subsets al final). El default 1_000_000 deja cualquier fila no backfilleada AL FINAL.
  numberSort             Int      @default(1000000)
  numberPrefix           String   @default("")
  createdAt              DateTime @default(now())

  inventoryItems             InventoryItem[]
  priceReferences            PriceReference[]
  pendingPrices              PendingPriceEntry[]
  sellRequestItems           SellRequestItem[]
  // v1.23-sealed-sales (M-28): suscripciones «avísame cuando vuelva» ancladas a esta carta.
  sealedRestockSubscriptions SealedRestockSubscription[]
  // v1.28 (M-30, §4.26a): controles de precio por (carta, variante[, grado]) — consola P-18/P-22.
  variantPriceOverrides      VariantPriceOverride[]
  // v1.29 (M-31, §4.27b): productos TCGplayer bajo esta carta (uno por productId). Navegación Prisma.
  cardProducts               CardProduct[]

  @@index([setId])
  @@index([name])
  @@index([rarity])
  // M-26: sirve el ORDER BY del binder y de `GET /buylist/cards` con `setId` (§4.22b).
  @@index([setId, numberPrefix, numberSort])
}

// v1.29 (M-31, ARCHITECTURE §4.27b) — UN producto TCGplayer (== un `productId`) bajo una carta de
// colección. El `productId` de TCGplayer es la CLAVE de emparejamiento (NUNCA el número de colección):
// una `Card` agrupa N `CardProduct`. Los `set_base` alimentan `Card.availableFinishes` y las variants
// del binder; los `deck_exclusive`/`promo` se exponen como productos vendibles/cotizables SEPARADOS
// (nunca funden sus acabados con la carta de set). `finishes` se lee EXACTO de los `subTypeName` de
// ESTE producto (deriveStructuralFinishes; desconocido ⇒ OMITIDO); jamás se unen con los de otro
// productId → el `normal` fantasma es imposible por construcción. Reemplaza a `Card.structuralFinishes`
// (que queda MUERTA, se dropea en migración posterior).
model CardProduct {
  id                 String          @id @default(uuid())
  cardId             String
  card               Card            @relation(fields: [cardId], references: [id])
  tcgplayerProductId Int             @unique
  kind               CardProductKind @default(set_base)
  name               String
  finishes           Finish[]        @default([])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  priceReferences PriceReference[]

  @@index([cardId])
  @@index([cardId, kind])
}

// ============================= INVENTORY / VAULT =============================

model VaultLocation {
  id        String    @id @default(uuid())
  zone      VaultZone
  box       String
  row       String
  slot      String
  label     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  items InventoryItem[]

  @@unique([zone, box, row, slot])
}

model InventoryItem {
  id                      String           @id @default(uuid())
  folio                   String           @unique
  cardId                  String
  card                    Card             @relation(fields: [cardId], references: [id])
  productType             ProductType
  rawCondition            RawCondition?
  // v1.1 (M-2): subtipo del sellado (solo productType=sealed; nullable en el resto).
  sealedSubtype           SealedSubtype?
  // v1.23-sealed-sales (M-28): condición SIMPLE del sellado, visible al comprador. App-requerido
  // para productType='sealed' (default `mint`); null para raw/graded. NO altera el precio (el
  // spread es por presentación). Separa grupos en el grid del sellado (§2-S). ARCHITECTURE §4.23i.
  sealedCondition         SealedCondition?
  gradingCompany          GradingCompany?
  gradeValue              String?
  // v1.2 (M-12): nº de certificado PSA/CGC (solo productType=graded; null para raw/sealed).
  // Requerido a nivel de APLICACIÓN para publicar una gradeada; no NOT NULL en BD.
  // v1.2 (M-13): eliminados frontPhotoKey/backPhotoKey/extraPhotoKeys (producto sin fotos propias;
  // la imagen es la de catálogo remota de pokemontcg.io).
  certNumber              String?
  locationId              String?
  location                VaultLocation?   @relation(fields: [locationId], references: [id])
  ownerType               OwnerType        @default(platform)
  ownerUserId             String?
  ownerUser               User?            @relation("OwnerUser", fields: [ownerUserId], references: [id])
  ownershipStatus         OwnershipStatus?
  status                  InventoryStatus  @default(in_stock)
  // v1.6-finish (M-18): acabado de ESTA copia física. Se captura al alta (M1) y debe
  // pertenecer a card.availableFinishes. Afecta la valuación (PriceReference de ESE acabado)
  // y el catálogo "Compra" (filtro/listado por acabado). graded/sealed → normal. ARCHITECTURE §3.7.
  finish                  Finish           @default(normal)
  listPriceCents          Int?
  acquisitionType         AcquisitionType
  acquisitionCostCents    Int?
  acquisitionPct          Int?
  // SEC-A3: unicidad para cerrar la doble conversión (convert-to-inventory) por carrera.
  // Dos conversiones concurrentes del mismo SellRequestItem colisionan aquí (P2002) y
  // solo una crea InventoryItem; la otra se trata como "ya convertido".
  sourceSellRequestItemId String?          @unique
  // v1.19-sealed-tcgcsv (M-23): mapeo CURADO del item SELLADO al producto de TCGplayer/TCGCSV
  // (ARCHITECTURE §4.19c). Se fijan JUNTOS (ambos null = no mapeado; ambos poblados = mapeado);
  // solo aplican a productType='sealed' — regla de APLICACIÓN, no constraint de BD. El groupId
  // se persiste porque el endpoint de precios de TCGCSV es POR GRUPO.
  tcgplayerProductId      Int?
  tcgplayerGroupId        Int?
  // v1.36-sealed-alta (M-37, P-35, §4.32c): imagen/nombre del producto sellado DESDE LA API
  // (TCGCSV/TCGplayer), capturados al alta y VALIDADOS server-side contra el host allowlist de
  // imágenes de TCGplayer/TCGCSV (anti stored-XSS / URL arbitraria). Solo aplican a
  // productType='sealed' (regla de APLICACIÓN, no constraint de BD). Display-only, money-safe
  // (jamás fijan precio). `null` ⇒ el display cae a la imagen/nombre de la `Card` ancla — arregla
  // que el sellado muestre la CAJA y no el single ancla en Compra/bóveda/M1. ARCHITECTURE §11 (M-37).
  sealedImageUrl          String?
  sealedProductName       String?
  // v1.39-sealed-product-module (M-39, P-38, §4.34a): IDENTIDAD del sellado — FK NULLABLE a la
  // entidad de catálogo `SealedProduct` (cura de raíz de SB-D5: reemplaza el ancla-a-single como
  // identidad). Regla de APLICACIÓN: poblada solo para productType='sealed'. `onDelete: SetNull`
  // para que desactivar/borrar un `SealedProduct` jamás rompa una FK de inventario/órdenes. Las
  // columnas M-23/M-37 (tcgplayerProductId/GroupId/sealedImageUrl/Name/sealedSubtype) se conservan
  // como SNAPSHOT por-pieza congelado al alta (estabilidad money-safe del display/valuación).
  sealedProductId         String?
  sealedProduct           SealedProduct?   @relation(fields: [sealedProductId], references: [id], onDelete: SetNull)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  movements     InventoryMovement[]
  orderItems    OrderItem[]
  shipmentItems ShipmentItem[]
  disputes      Dispute[]
  // v1.20 (M-24): ajustes por levantamiento físico registrados sobre esta pieza.
  adjustments   InventoryAdjustment[]

  @@index([cardId])
  @@index([status])
  @@index([ownerUserId])
  @@index([locationId])
  // v1.16-master-set (M-21): sirve la agregación `countsByFinish` del binder
  // (GROUP BY cardId, finish filtrando status on-hand) y el conteo por set del índice
  // Master Set. Complementa (no reemplaza) los índices existentes. ARCHITECTURE §4.17a.
  @@index([cardId, finish, status])
  // v1.19-sealed-tcgcsv (M-23): sirve la cola de NO-mapeados (sealed AND productId IS NULL)
  // y el DISTINCT tcgplayerGroupId del ingest sin barrer la tabla. ARCHITECTURE §11.
  @@index([tcgplayerProductId])
  // v1.23-sealed-sales (M-28): sirve el grid público del sellado (`productType='sealed' AND
  // status='listed'`) y la agregación de la pestaña «Sellado» sin barrer la tabla. ARCHITECTURE §4.23i.
  @@index([productType, status])
  // v1.39 (M-39, P-38): sirve la resolución de display en cascada (SealedProduct vivo) y el reporte
  // de reconciliación (sellado con sealedProductId IS NULL) sin barrer la tabla.
  @@index([sealedProductId])
}

model InventoryMovement {
  id             String           @id @default(uuid())
  itemId         String
  item           InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocationId String?
  toLocationId   String?
  fromStatus     InventoryStatus?
  toStatus       InventoryStatus?
  reason         MovementReason
  actorUserId    String?
  note           String?
  createdAt      DateTime         @default(now())

  @@index([itemId])
}

// v1.20-master-set-everywhere (M-24): registro TIPADO y consultable del ajuste de inventario por
// levantamiento físico (POST /admin/inventory/adjustments, ARCHITECTURE §4.20e). Tabla propia y NO
// solo AuditLog porque el motivo debe ser consultable para reportes de merma/levantamiento (M7/M9);
// complementa —no reemplaza— InventoryMovement(reason=adjustment) y AuditLog. Para `encontrada` con
// qty>1 se crea UNA fila por pieza creada. Sin FK dura a User (patrón AuditLog).
model InventoryAdjustment {
  id              String           @id @default(uuid())
  inventoryItemId String
  item            InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  reason          AdjustmentReason
  fromStatus      InventoryStatus?
  toStatus        InventoryStatus
  actorUserId     String?
  note            String?
  createdAt       DateTime         @default(now())

  @@index([inventoryItemId])
  @@index([reason])
  @@index([createdAt])
}

// v1.16-master-set (M-21): idempotencia + auditoría del alta/publicación por LOTE (ARCHITECTURE
// §4.17b). El `id` ES el `batchKey` (idempotencia natural): un replay del mismo batchKey devuelve
// `resultJson` sin re-crear. Es el registro de auditoría del lote (complementa AuditLog). NO cambia
// el modelo por-pieza (sigue 1 InventoryItem por pieza física). Sin FK dura a User (patrón AuditLog).
model InventoryBatch {
  id           String   @id // = batchKey (idempotency key)
  actorUserId  String?
  kind         String // 'create' | 'publish' | 'adjust' | 'publish_all' | 'bulk_remove' — free-form TEXT
  // (NO es enum de BD; sin CHECK). v1.20.1: idempotencia del ajuste `encontrada`; v1.28: 'publish_all';
  // v1.35 (H1): 'bulk_remove' (idempotencia de la baja rápida por cantidad, §M1). Añadir un valor NO
  // requiere migración — es una columna TEXT libre (mismo precedente que 'publish_all', sin migración).
  requested    Int
  createdItems Int
  failedLines  Int
  resultJson   Json
  createdAt    DateTime @default(now())
}

// ============================= PRICING / FX =============================

// v1.28 (M-30, ARCHITECTURE §4.26a) — Controles de precio POR (carta, variante[, grado]): override
// de VENTA (pisa el storefront para piezas sin `listPriceCents` manual), override de COMPRA (pisa
// el cotizador público de buylist) y el bounty P-22 (precio premium explícito + objetivo opcional).
// Es la TERCERA perilla de dinero, distinta de la referencia de MERCADO (`PriceReference
// isManualOverride`, informativa) y del precio manual POR PIEZA (`InventoryItem.listPriceCents`,
// que GANA para esa pieza). Precedencias normativas en §4.26b. Una fila VIGENTE por variante
// (upsert; sin serie temporal — la auditoría del cambio va por AuditLog). La clave única espeja la
// de PriceReference menos `capturedDate`. `sealed` NO usa esta tabla (§4.26g: su cadena H-1 sigue).
model VariantPriceOverride {
  id                String      @id @default(uuid())
  cardId            String
  card              Card        @relation(fields: [cardId], references: [id])
  productType       ProductType @default(raw) // raw | graded (P-20). sealed NO usa esta tabla (§4.26g).
  gradeKey          String      @default("raw:NM") // canónico de buildGradeKey: "raw:NM" | "graded:PSA:10" …
  finish            Finish      @default(normal) // graded → normal (el acabado no aplica; paridad PriceReference)
  sellOverrideCents Int? // precio de VENTA manual → PISA el storefront (§4.26b). null = sin override
  buyOverrideCents  Int? // precio de COMPRA manual → PISA el cotizador público (§4.26b). null = sin override
  bountyEnabled     Boolean     @default(false) // P-22
  bountyPriceCents  Int? // requerido si bountyEnabled — SIEMPRE explícito, jamás calculado
  bountyTargetQty   Int? // "necesito N"; null = sin objetivo (no se auto-apaga)
  bountyAcquiredQty Int         @default(0) // piezas compradas vía buylist PAGADA bajo bounty (§4.26e)
  bountyCompletedAt DateTime?
  updatedBy         String? // actorUserId (patrón AuditLog, sin FK dura)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([cardId, productType, gradeKey, finish])
  @@index([bountyEnabled])
}

model PriceReference {
  id               String       @id @default(uuid())
  cardId           String
  card             Card         @relation(fields: [cardId], references: [id])
  productType      ProductType
  gradeKey         String
  // v1.6-finish (M-18): acabado ORTOGONAL a gradeKey (que sigue describiendo condición/grado).
  // Añadido a la clave única: `normal` y `reverse_holo` de la misma carta tienen referencia de
  // precio DISTINTA (una fila por día por acabado). El provider guarda el precio POR acabado
  // (`tcgplayer.prices[finish].market`), no "el primer market disponible". ARCHITECTURE §3.2/§4.1.
  finish           Finish       @default(normal)
  source           PriceSource
  // v1.29 (M-31, §4.27b): FK NULLABLE al producto TCGplayer. Se PUEBLA para singles (precio POR
  // producto+acabado, source=tcgcsv_singles) y queda NULL para graded/sealed y para el fallback
  // PPT/pokemontcg.io. Entra a la `@@unique` para que dos productos de la MISMA carta que expongan
  // el MISMO Finish (p. ej. set_base holofoil y una promo holofoil) no colisionen. Para
  // cardProductId=null la clave se comporta como antes de M-31.
  cardProductId    String?
  cardProduct      CardProduct? @relation(fields: [cardProductId], references: [id])
  priceUsdCents    Int?
  fxRate           Decimal?     @db.Decimal(12, 6)
  fxBufferPct      Decimal?     @db.Decimal(6, 3)
  priceMxnCents    Int
  capturedDate     DateTime     @db.Date
  isManualOverride Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@unique([cardId, productType, gradeKey, finish, capturedDate, cardProductId])
  @@index([cardId])
  @@index([cardProductId])
}

model PendingPriceEntry {
  id                 String              @id @default(uuid())
  cardId             String
  card               Card                @relation(fields: [cardId], references: [id])
  productType        ProductType
  gradeKey           String
  // v1.8-ronda-c (M-19): acabado ORTOGONAL a gradeKey (igual que en PriceReference). La cola de
  // precio pendiente es POR acabado: `normal` y `holofoil` de la misma carta sin precio son
  // entradas SEPARADAS. Antes se colapsaban en una y el override de un acabado cerraba el pendiente
  // de los demás. Default seguro `normal` para filas legacy (sin backfill). ARCHITECTURE §3.2/§4.1.
  finish             Finish              @default(normal)
  // v1.30 (M-32, §4.29d): productId TCGplayer (== SellRequestItem.cardProductId) cuando la entrada
  // corresponde a un producto SEPARADO. Entra a la clave LÓGICA de dedupe de la cola (junto a
  // cardId/productType/gradeKey/finish): resolver el precio del set_base NO cierra la del Deck
  // Exclusive (money-safe, misma doctrina que `finish` en M-19). `null` = base (retrocompatible).
  cardProductId      Int?
  context            PendingPriceContext
  refId              String?
  status             PendingPriceStatus  @default(open)
  resolvedPriceRefId String?
  createdAt          DateTime            @default(now())
  resolvedAt         DateTime?

  @@index([status])
}

model FxRate {
  id            String   @id @default(uuid())
  base          String   @default("USD")
  quote         String   @default("MXN")
  rate          Decimal  @db.Decimal(12, 6)
  bufferPct     Decimal  @db.Decimal(6, 3)
  effectiveDate DateTime @db.Date
  source        String // banxico | manual (fuente propia; ver ARCHITECTURE §3.2)
  createdAt     DateTime @default(now())

  @@index([effectiveDate])
}

// ============================= ORDERS =============================

model Order {
  id                      String          @id @default(uuid())
  // v1.21-guest-checkout (M-25): NULLABLE para alojar el pedido de INVITADO (sin cuenta).
  // NO relaja ninguna autorización: la puerta sigue siendo `order.userId !== :sessionUser`
  // y `null` nunca iguala a un uuid de sesión. Invariante: userId != null OR guestEmail != null.
  // `onDelete: Restrict` EXPLÍCITO (no el `SetNull` que Prisma pondría por defecto en una relación
  // opcional): borrar un usuario NO debe huerfanar sus pedidos. Además, con `SetNull` un borrado
  // duro rompería el CHECK `claimedAt IS NOT NULL => userId IS NOT NULL`. Se conserva así el
  // comportamiento previo a M-25 (los usuarios se SOFT-borran, M-15).
  userId                  String?
  user                    User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  // v1.21 (M-25): correo del invitado, normalizado (trim + lowercase) por la aplicación.
  // `guestEmail != null` <=> el pedido NACIÓ como pedido de invitado (inmutable; sobrevive al reclamo).
  guestEmail              String?
  // v1.21 (M-25): número legible `TCG-000123` (secuencia `order_number_seq`). Nullable SOLO por el
  // backfill de la migración; la aplicación lo escribe SIEMPRE en pedidos nuevos.
  orderNumber             String?         @unique
  // v1.21 (M-25): destino del pedido. Default `vault` = comportamiento previo bit a bit.
  fulfillmentMode         FulfillmentMode @default(vault)
  // v1.21 (M-25): dirección capturada en línea (el invitado no tiene `Address`). Mismo criterio de
  // snapshot que ShipmentRequest.addressSnapshot. Obligatoria (app) cuando fulfillmentMode=direct_ship.
  shippingAddressSnapshot Json?
  // v1.21 (M-25): envío cobrado DENTRO de esta orden (mismo PaymentIntent). 0 en pedidos a bóveda
  // => el P&L histórico no cambia. Única fuente del ingreso de envío de un pedido de invitado.
  shippingFeeCents        Int             @default(0)
  // v1.21 (M-25): momento del reclamo (conversión a cuenta). claimedAt != null => userId != null.
  claimedAt               DateTime?
  // v1.21 (M-25): idioma del correo del invitado (no hay User). order.locale ?? user.locale ?? 'es'.
  locale                  Locale?
  // v1.21 (M-25): marca + 4 últimos de la tarjeta, capturados del charge al liquidar. Dato permitido
  // por PCI-DSS; JAMÁS PAN, BIN ni titular. Alimentan GuestTrackingPaymentDTO (§4-G.3).
  paymentMethodBrand      String?
  paymentMethodLast4      String?
  status                  OrderStatus     @default(pending)
  subtotalCents           Int
  processingFeeCents      Int
  ivaCents                Int
  totalCents              Int
  ivaRatePct              Int             @default(16)
  stripePaymentIntentId   String?         @unique
  stripeChargeId          String?
  billingSnapshot         Json?
  cfdiStatus              CfdiStatus      @default(no_aplica)
  invoiceRequested        Boolean         @default(false)
  // Fix 4: contracargo con carta ya ENVIADA/ENTREGADA (no se pudo revertir al inventario);
  // requiere gestión manual (pelear el contracargo con la guía de entrega).
  chargebackNeedsManual   Boolean         @default(false)
  // Fix 5: resultado del cierre de la disputa (charge.dispute.closed / funds_reinstated):
  // "won" | "lost". Informativo/auditoría (OrderStatus no cambia: won→settled, lost→chargeback).
  disputeOutcome          String?
  createdAt               DateTime        @default(now())
  settledAt               DateTime?
  refundedAt              DateTime?

  items            OrderItem[]
  // v1.21 (M-25): enlaces de seguimiento del pedido de invitado (solo SHA-256 del claro).
  accessTokens     OrderAccessToken[]
  // v1.21 (M-25): envíos que fulfillan esta orden (envío directo). Vacío en pedidos a bóveda.
  shipmentRequests ShipmentRequest[]

  @@index([userId])
  @@index([status])
  // v1.21 (M-25): sirve GET /orders/claimable y el reenvío por (email, orderNumber).
  @@index([guestEmail])
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  cardSnapshot    Json
  unitPriceCents  Int

  @@index([orderId])
}

// ============================= SHIPMENTS =============================

model ShipmentRequest {
  id                    String         @id @default(uuid())
  // v1.21-guest-checkout (M-25): NULLABLE. `null` SOLO en el envío directo de un pedido de
  // invitado (creado por el servidor al liquidar). GET /shipments[...] debe filtrar por
  // `userId = :sessionUser` de forma POSITIVA para que un envío `userId=null` no aparezca nunca.
  // `onDelete: Restrict` explícito (ver la misma nota en `Order.userId`).
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // v1.21 (M-25): DISCRIMINADOR. `null` = retiro de bóveda (todo lo existente); poblado = envío
  // directo que fulfilla ese pedido. NO @unique: deja abierta la re-expedición sin migrar.
  // Invariante de aplicación: a lo más UN envío activo por orden.
  orderId               String?
  order                 Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  addressSnapshot       Json
  status                ShipmentStatus @default(solicitado)
  shippingFeeCents      Int
  shippingCostCents     Int            @default(0)
  ivaCents              Int            @default(0)
  processingFeeCents    Int            @default(0)
  totalCents            Int            @default(0)
  stripePaymentIntentId String?        @unique
  carrier               String?
  trackingNumber        String?
  requestedAt           DateTime       @default(now())
  pickingAt             DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?

  items ShipmentItem[]

  @@index([userId])
  @@index([status])
  // v1.21 (M-25): join orden->envío de la vista pública de seguimiento.
  @@index([orderId])
}

model ShipmentItem {
  id                String          @id @default(uuid())
  shipmentRequestId String
  shipmentRequest   ShipmentRequest @relation(fields: [shipmentRequestId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id])

  @@index([shipmentRequestId])
}

// ============================= BUYLIST =============================

model SellRequest {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  status             SellRequestStatus @default(cotizada)
  quotedTotalCents   Int               @default(0)
  approvedTotalCents Int?
  // Snapshot de CLABE cifrado en reposo (AES-256-GCM). Reveal on-demand para pagar SPEI.
  clabeSnapshotEnc   String?
  ineRequired        Boolean           @default(false)
  ineProvided        Boolean           @default(false)
  speiReference      String?
  paidBy             String?
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  receivedAt         DateTime?
  verifiedAt         DateTime?
  approvedAt         DateTime?
  adjustmentSentAt   DateTime?
  deadlineAt         DateTime?
  // v1.8-ronda-c / SEC-D2 (M-19): fecha del cierre REAL de la solicitud, seteada al entrar a un
  // estado terminal (`pagada`/`rechazada`/`abandonada`). Ancla la ventana de retención de INE al
  // cierre efectivo (ine-retention.service), en vez de aproximarla por timestamps de estado. Campo
  // INTERNO de cumplimiento: NO se expone en DTOs de cliente. Nullable (filas legacy usan fallback).
  closedAt           DateTime?

  items SellRequestItem[]

  @@index([userId])
  @@index([status])
}

model SellRequestItem {
  id                 String           @id @default(uuid())
  sellRequestId      String
  sellRequest        SellRequest      @relation(fields: [sellRequestId], references: [id], onDelete: Cascade)
  cardId             String
  card               Card             @relation(fields: [cardId], references: [id])
  productType        ProductType
  rawCondition       RawCondition?
  // v1.6-finish (M-18): snapshot del acabado aplicado en la cotización/solicitud (validado
  // contra card.availableFinishes al crear). Determina la regla y la referencia usadas
  // (ARCHITECTURE §4.2.1). Al convertir a inventario (M5), se PROPAGA a InventoryItem.finish.
  finish             Finish           @default(normal)
  // v1.30 (M-32, §4.29d): snapshot del `tcgplayerProductId` (== CardProductDTO.productId de
  // `separateProducts`) cuando la LÍNEA es un producto SEPARADO (deck_exclusive/promo). Es el mismo
  // eje que M-31 metió en `PriceReference.cardProductId`; entra a la clave LÓGICA de la línea, de modo
  // que dos ítems con el mismo (cardId, finish) pero distinto productId son DISTINTOS (no se funden).
  // Se PROPAGA al InventoryItem al convertir (M5): la pieza queda ligada a ESE producto, no al set_base.
  // `null` = línea de set_base (retrocompatible; filas < M-32 quedan en null). Análogo a como M-19 añadió
  // `finish`. Es el productId TCGplayer (Int), NO el UUID interno CardProduct.id.
  cardProductId      Int?
  // v1.3.1 (M-14): la cotización ya NO usa `category` (BuylistCategory). Se snapshotea la
  // REGLA POR RAREZA aplicada (auditoría). `category` queda NULLABLE/legacy (retención de
  // filas históricas); nada nuevo lo escribe. Ver ARCHITECTURE §3.2/§4.2.
  category           BuylistCategory?
  rarity             String?
  ruleMode           BuylistRuleMode?
  ruleValue          Int?
  ruleSource         String? // "rule" (fila explícita) | "fallback" (BUYLIST_PRICE_FALLBACK_PCT)
  quotedPriceCents   Int?
  approvedPriceCents Int?
  itemStatus         SellItemStatus   @default(cotizada)
  inventoryItemId    String?
  // v1.2 (M-13): eliminado photoKeys (buylist sin fotos de carta; verificación NM contra la física).
  // v1.18-buylist-rejects (M-22): rechazo de ítem operable. `rejectedAt` = timestamp de la decisión
  // `reject` (= notificación al vendedor) y ANCLA ÚNICA de los plazos derivados 7d (devolución a
  // costo del usuario) / 30d (abandono) — NO se persisten los plazos. `rejectionReason` = motivo
  // obligatorio del rechazo (3–500 chars). Nullable sin backfill: ítems rechazados pre-M-22 (legacy)
  // exponen los campos de rechazo en null. Ver ARCHITECTURE §4.18 / §11 (M-22).
  rejectedAt         DateTime?
  rejectionReason    String?

  @@index([sellRequestId])
  // M-22: sirve GET /admin/buylist/rejected-items (filtro transversal itemStatus='rechazada').
  @@index([itemStatus])
}

// ============================= DISPUTES =============================

model Dispute {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])
  orderItemId       String?
  type              String        @default("condition_raw")
  status            DisputeStatus @default(abierta)
  // v1.2 (M-13): eliminados ingressPhotoKeys/claimPhotoKeys (evidencia por correo a soporte).
  description       String
  resolution        String?
  repurchaseOrderId String?
  deadlineAt        DateTime
  createdAt         DateTime      @default(now())
  resolvedAt        DateTime?
  resolvedBy        String?

  @@index([userId])
  @@index([status])
}

// ============================= CONFIG / AUDIT =============================

model ConfigSetting {
  key       String   @id
  valueJson Json
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorRole   Role?
  action      String
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================= PORTFOLIO SNAPSHOTS =============================

// v1.1 (M-8): serie temporal por usuario que alimenta la gráfica de tendencia del
// portafolio ("Mi bóveda", estilo acciones). Escrita por el job diario
// `portfolio-snapshot` (idempotente por día vía @@unique). ARCHITECTURE §3 / §5.
model PortfolioSnapshot {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asOfDate           DateTime @db.Date
  totalValueMxnCents Int
  costBasisMxnCents  Int?
  pendingPriceCount  Int      @default(0)
  createdAt          DateTime @default(now())

  @@unique([userId, asOfDate])
  @@index([userId, asOfDate])
}

// ============================= SET VALUE SNAPSHOTS (v1.9-set-chart) =============================

// v1.9-set-chart (M-20): serie temporal POR SET que alimenta la gráfica PÚBLICA del hero de la
// home (visitantes anónimos, estilo acciones). Análogo de PortfolioSnapshot pero agregando por
// `setId` en vez de por `userId`. Como pokemontcg.io solo da precio de HOY (sin historial), la
// serie se siembra con el valor de hoy y crece con captura diaria (no se fabrican puntos).
// Escrita por los jobs `set-price-sync` + `set-value-snapshot` (idempotente por día vía @@unique).
// SEC-A1: totalValueMxnCents se deriva SIEMPRE de PriceReference real. ARCHITECTURE §3.2 / §4.12.
model SetValueSnapshot {
  id                 String   @id @default(uuid())
  setId              String
  set                CardSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  asOfDate           DateTime @db.Date
  // Valor agregado MXN (centavos) de las cartas PRICEADAS del set ese día (regla §4.12a).
  totalValueMxnCents Int
  // Cuántas cartas del set tenían precio ese día (las que entran al total).
  pricedCardCount    Int
  // Cuántas cartas tiene el set en total (Card con ese setId). Invariante pricedCardCount <= totalCardCount.
  totalCardCount     Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // TD-2 (techlead): el @@unique([setId, asOfDate]) ya crea un índice B-tree sobre esas mismas
  // columnas en el mismo orden, que sirve las consultas por rango de la gráfica. Un @@index aparte
  // sería redundante (índice duplicado, doble coste de escritura). No se añade.
  @@unique([setId, asOfDate])
}

// ============================= AUTH TOKENS (v1.5) =============================

// v1.5 (M-17): token de UN SOLO USO para verificación de correo y reset de contraseña
// self-service. NUNCA guarda el token en claro: el claro (32 bytes aleatorios, ~256 bits)
// viaja solo por correo; en BD vive su SHA-256 (`tokenHash`). Expira 24h (verificación) /
// 1h (reset). Al emitir uno nuevo del mismo tipo para el usuario se invalidan los previos
// no usados (rotación). Barrido housekeeping: job `auth-token-sweep`. ARCHITECTURE §3.2/§4.11.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  // SHA-256 (hex) del token en claro. @unique = lookup por hash del token presentado.
  tokenHash String        @unique
  expiresAt DateTime
  // Se setea al consumir (un solo uso). null = vigente.
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// v1.21-guest-checkout (M-25): ENLACE DE SEGUIMIENTO del pedido de invitado. El claro (32 bytes
// aleatorios base64url, 256 bits) viaja SOLO por correo / por la respuesta del checkout a quien
// acaba de crear el pedido; en BD vive ÚNICAMENTE su SHA-256 (`tokenHash`), así que un dump de BD
// NO produce enlaces válidos. MULTI-USO (el invitado reabre su enlace): revocable (`revokedAt`),
// no consumible (no hay `usedAt`) — única diferencia semántica con `AuthToken`, y la razón de no
// reusar ese modelo (su `userId` es obligatorio y su `consume()` es de un solo uso).
// TTL 90d, rotación al reenviar, revocación al reclamar. ARCHITECTURE §4.21e / API_CONTRACT §4-G.7.
model OrderAccessToken {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SHA-256 (hex) del token en claro. @unique = lookup por hash del token presentado.
  tokenHash  String    @unique
  expiresAt  DateTime
  // MULTI-USO: revocable, NO consumible. Se revoca al reclamar, al rotar y por soporte.
  revokedAt  DateTime?
  // Telemetría de abuso (escritura best-effort).
  lastUsedAt DateTime?
  useCount   Int       @default(0)
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([expiresAt])
}

// ============================= STRIPE IDEMPOTENCY =============================

model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ============================= SEALED RESTOCK (v1.23-sealed-sales) =============================

// v1.23-sealed-sales (M-28): «Avísame cuando vuelva» — suscripción por correo a la reposición de
// un producto SELLADO agotado. FEATURE-FLAGGED por el dial `sealed_restock_alerts` (seed off): solo
// se puebla con el flag encendido. Identidad de producto = `tcgplayerProductId` (mapeado, preferido)
// o `cardId (+ sealedSubtype)`, más `sealedCondition`. Acepta correo de invitado o de usuario
// logueado (userId opcional, onDelete SetNull). Un job cableado (`sealed-restock-notify`) empareja
// suscripciones pendientes (`notifiedAt IS NULL`) cuando el producto vuelve a `listed`, envía correo
// y marca `notifiedAt`. ARCHITECTURE §4.23h / §11 (M-28) / API_CONTRACT §2-S.
model SealedRestockSubscription {
  id                 String          @id @default(uuid())
  // Correo normalizado (lowercase/trim). No @unique: un correo puede seguir varios productos.
  email              String
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  cardId             String
  card               Card            @relation(fields: [cardId], references: [id])
  sealedSubtype      SealedSubtype?
  tcgplayerProductId Int?
  sealedCondition    SealedCondition
  notifiedAt         DateTime?
  createdAt          DateTime        @default(now())

  // Empareja «producto vuelto a listed» → suscripciones pendientes (notifiedAt IS NULL) sin barrer.
  @@index([tcgplayerProductId, sealedCondition, notifiedAt])
  @@index([email])
  @@index([cardId])
}
