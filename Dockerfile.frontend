# =============================================================================
# Dockerfile.frontend — Next.js 14 App Router (Node 20 LTS)  ·  devops
# Marketplace TCG con Bóveda (Pokémon, México)
# =============================================================================
# Multi-stage. Contexto de build = RAÍZ del repo (ver docker-compose.yml); el
# código vive en `frontend/`. Se mantiene en la raíz para respetar la propiedad
# de archivos de CLAUDE.md (devops NO escribe en frontend/).
#
# ESTADO ACTUAL: `frontend/` todavía no existe (greenfield). Listo para cuando
# el rol frontend cree la app Next.js. Mientras no exista, este build fallará;
# es esperado. Ver docs/DEVOPS_NOTES.md.
#
# Se asume el output "standalone" de Next.js para una imagen final mínima:
#   next.config.js -> { output: 'standalone' }
# Si el frontend no usa standalone, se ajusta la etapa runtime aquí (devops).
#
# Las NEXT_PUBLIC_* se inyectan en build-time como ARGs (se hornean en el bundle
# del navegador). NO poner secretos aquí: solo claves públicas.
# =============================================================================

# ---- Base ----
FROM node:20-alpine AS base
# SEGURIDAD (2026-08-18): `apk upgrade` ANTES de instalar nada.
# La imagen `node:20-alpine` viene con los paquetes de Alpine congelados al momento
# en que se publicó el tag, así que arrastra CVEs de la capa OS que YA están
# parcheados en el repo de Alpine. Caso concreto que rompió el gate: `libcrypto3`
# y `libssl3` 3.5.6-r0 (CVE-2026-45447, use-after-free en PKCS7_verify de OpenSSL,
# HIGH), parcheado en 3.5.7-r0. El backend no lo sufría por casualidad: su base
# hace `apk add openssl`, que resuelve contra el índice ACTUAL del repo y de paso
# arrastraba las libs al día; aquí no se instala openssl, así que se quedaban las
# de la imagen. `apk upgrade` lo arregla de raíz y para ambos, y además cubre
# futuros CVE de la capa OS sin depender de que el tag de Node se reconstruya.
RUN apk upgrade --no-cache && apk add --no-cache libc6-compat
WORKDIR /app

# ---- Dependencias ----
FROM base AS deps
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# ---- Build ----
FROM base AS build
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_DEFAULT_LOCALE
# false = el bundle llama al backend real; true = fixtures mock. Se hornea aquí.
ARG NEXT_PUBLIC_USE_MOCKS=false
# Login con Google (v1.2): Client ID OAuth 2.0 (público). Se hornea en el bundle.
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_DEFAULT_LOCALE=$NEXT_PUBLIC_DEFAULT_LOCALE
ENV NEXT_PUBLIC_USE_MOCKS=$NEXT_PUBLIC_USE_MOCKS
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
# `public/` es OPCIONAL en Next.js; hoy frontend/ no lo tiene. Garantizamos que
# exista para que el COPY del runtime no rompa el build (Vercel no usa este
# Dockerfile; es para el stack local/staging de docker-compose).
RUN mkdir -p public
RUN npm run build

# ---- Runtime (standalone, imagen final mínima) ----
FROM base AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
# SEGURIDAD (2026-08-17): npm FUERA del runtime.
# El npm que trae `node:20-alpine` empaqueta sus propias deps en
# /usr/local/lib/node_modules/npm/node_modules/ (tar, brace-expansion,
# cross-spawn, minimatch, sigstore...) y Trivy las reporta como HIGH/CRITICAL en
# la sección node-pkg. No son deps de la app ni se pueden bumpear desde
# frontend/package.json: vienen con la imagen base. El runtime standalone arranca
# con `node server.js` y nunca usa npm/npx, así que se eliminan (arreglo real, no
# un ignore). Las etapas `deps` y `build` conservan npm para `npm ci`/`npm run build`.
# El `if` es un GUARD: si una imagen base futura mueve esas rutas, el build FALLA
# aquí con mensaje claro en vez de publicar una imagen que sigue trayendo npm.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && if command -v npm >/dev/null 2>&1 || [ -d /usr/local/lib/node_modules/npm ]; then \
      echo "ERROR: npm sigue presente en la etapa runtime; revisar rutas de la imagen base."; \
      exit 1; \
    fi \
 && node -e "console.log('runtime sin npm; node ' + process.version)"
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
# Output standalone de Next.js: server + solo las deps necesarias.
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /app/public ./public
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
