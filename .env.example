# =============================================================================
# .env.example — Marketplace TCG con Bóveda (Pokémon, México)
# =============================================================================
# Propiedad: devops. Copia este archivo a `.env` y rellena los valores reales.
#
#   cp .env.example .env
#
# NUNCA se comitea `.env` (está en .gitignore). Aquí solo hay PLACEHOLDERS.
# Los valores marcados como "(local ok)" ya funcionan tal cual con el
# docker-compose local; el resto exige que TÚ pongas credenciales reales.
#
# Los "diales" de negocio (tarifa de envío, IVA, topes de buylist, % de
# aportación, proveedor de precios por tipo...) NO viven aquí: viven en la
# tabla ConfigSetting (M10), editables sin redeploy. Ver ARCHITECTURE §3.2.
# =============================================================================
#
# =============================================================================
# DÓNDE VIVE CADA VARIABLE EN PRODUCCIÓN (topología Vercel + Railway + R2)
# =============================================================================
# Este archivo es para el entorno LOCAL. En prod NO existe un `.env`: cada
# variable se carga en el secret manager de su plataforma. Clasificación:
#
#   [GH]  GitHub Secrets  (Settings > Secrets and variables > Actions)
#         Solo tokens/URLs que usa el pipeline .github/workflows/deploy.yml:
#           RAILWAY_TOKEN, VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
#           STAGING_BASE_URL, PROD_BASE_URL
#         (opcional para E2E/DAST manual: STRIPE_TEST_* si se corren en CI)
#
#   [RW]  Railway > servicio "backend" > Variables (runtime del backend)
#           NODE_ENV=production, APP_BASE_URL, DEFAULT_LOCALE,
#           JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, JWT_ACCESS_TTL, JWT_REFRESH_TTL,
#           PII_ENCRYPTION_KEY, PII_HMAC_KEY,
#           STRIPE_SECRET_KEY (live), STRIPE_PUBLISHABLE_KEY (live), STRIPE_WEBHOOK_SECRET,
#           GOOGLE_CLIENT_ID (login con Google — verificación del ID token),
#           DISPUTE_EVIDENCE_CONTACT (correo de contacto para evidencia de disputa),
#           POKEMONTCG_IO_API_KEY, POKEMONPRICETRACKER_API_KEY, POKETRACE_API_KEY,
#           POKEMONPRICETRACKER_MARKET_FORMAT (money-safe: vacío = ingest de paga en sample-only),
#           S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
#           S3_FORCE_PATH_STYLE, INE_RETENTION_DAYS, KYC_UPLOAD_MAX_BYTES (opc.),
#           (bucket SOLO para kyc_ine)
#           FX_SOURCE=banxico, BANXICO_SIE_TOKEN,
#           HOME_FEATURED_SET_ID (gráfica pública del "set destacado" del hero),
#           PRICE_INGEST_CRON_1/_2 (opc., horario del ingest masivo WS-A; UTC; DEFAULT-ON 2×/día),
#           CATALOG_METADATA_SYNC_CRON (opc., import diario de metadata/sets nuevos, force:false),
#           SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD, SEED_OPERATOR_EMAIL, SEED_OPERATOR_PASSWORD
#         DATABASE_URL y REDIS_URL los INYECTA Railway (add-ons Postgres/Redis);
#         no los pongas a mano — usa las referencias ${{ Postgres.DATABASE_URL }}
#         y ${{ Redis.REDIS_URL }} de Railway.
#
#   [VC]  Vercel > proyecto frontend > Settings > Environment Variables
#         (env "Production" y "Preview"=staging). Solo claves PÚBLICAS:
#           NEXT_PUBLIC_API_BASE_URL, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_live_),
#           NEXT_PUBLIC_DEFAULT_LOCALE, NEXT_PUBLIC_USE_MOCKS=false,
#           NEXT_PUBLIC_GOOGLE_CLIENT_ID (mismo OAuth Client ID que GOOGLE_CLIENT_ID)
#
#   [M10] Dial de negocio en ConfigSetting (NO es env): markup de venta, tarifa
#         de envío MX$175, IVA 16%, topes buylist, aportación 70%, tope de
#         reposición, colchón FX, stripe_fee_* del gross-up, PricingProvider/tipo,
#         price_provider (PRICE_PROVIDER: pokemonpricetracker | pokemontcg_io — dial
#         del ingest masivo WS-A; se cambia por el PANEL M10, no por env/Railway).
#
# Regla: NUNCA subas valores reales al repo. `gitleaks` (security-sast.yml) vigila.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
NODE_ENV=development
# URL base pública de la app (frontend). Usada por el backend para armar links
# (Stripe return_url, correos, etc.). En prod = tu dominio con https.
APP_BASE_URL=http://localhost:3000
# Idioma por defecto de la plataforma (ES/EN, default ES). Ver ARCHITECTURE §6.
DEFAULT_LOCALE=es

# -----------------------------------------------------------------------------
# PostgreSQL 16  (local ok — estos valores coinciden con docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=tcg
POSTGRES_PASSWORD=tcg_local_dev_password
POSTGRES_DB=tcg_marketplace
# Cadena de conexión que consume Prisma / NestJS.
# Local (desde tu host, contra el contenedor):
DATABASE_URL=postgresql://tcg:tcg_local_dev_password@localhost:5432/tcg_marketplace?schema=public
# Nota: cuando el backend corre DENTRO de docker-compose (perfil "apps"), el host
# es `postgres` (nombre del servicio), no `localhost`. docker-compose ya lo
# inyecta con esa variante; ver docker-compose.yml.

# -----------------------------------------------------------------------------
# Redis 7  (cache, colas BullMQ, rate-limit del free tier)  (local ok)
# -----------------------------------------------------------------------------
# REQUISITO OPERATIVO de los jobs programados (BullMQ). Sin REDIS_URL el
# SchedulerService NO programa NINGÚN cron (queda deshabilitado con un warning):
# ni price-ingest (WS-A), ni fx-refresh, ni los barridos/snapshots. En ese caso
# los jobs SOLO son disparables a mano (y price-ingest corre secuencial AWAITED,
# nunca fire-and-forget). Además, la cola persistida en Redis es lo que hace el
# price-ingest REANUDABLE (un reinicio a media corrida retoma los sets pendientes).
# En prod = requisito (Railway lo inyecta con ${{ Redis.REDIS_URL }}). Ver DEVOPS_NOTES §19.
REDIS_URL=redis://localhost:6379
# Dentro de docker-compose (perfil "apps") el host es `redis`.
#
# REDIS_FAMILY — OPCIONAL: familia IP del lookup DNS de las conexiones Redis del
# backend (scheduler BullMQ + health). Valores: 0 = dual-stack IPv4+IPv6 (DEFAULT
# en código) | 4 = solo IPv4 | 6 = solo IPv6. Precedencia: esta env > `?family=`
# en la propia REDIS_URL (se respeta, no se pisa) > default 0. A diferencia de
# los crons, aquí la cadena VACÍA es segura (cae al default 0).
# Normalmente NO hay que fijarla: el default 0 funciona igual en local/CI (IPv4)
# y en Railway (IPv6). Úsala SOLO para forzar una familia ante un DNS anómalo
# (p. ej. un resolver que devuelve AAAA sin conectividad IPv6 real → fija 4).
#   NOTA RAILWAY: el private networking (`redis.railway.internal`) resuelve SOLO
#   IPv6 (AAAA). El default de ioredis (family:4) NO conecta ahí — fue la causa
#   del scheduler muerto en silencio y del catálogo sin precios (auditoría
#   BACKEND_NOTES §43; checklist post-deploy en DEVOPS_NOTES §20). Con el default
#   family:0 del código YA funciona sin fijar nada ni en local ni en Railway.
#   Si en vez del hostname interno se usa la URL PÚBLICA del add-on (proxy TCP
#   con hostname público, resuelve IPv4), esta variable no afecta.
REDIS_FAMILY=

# -----------------------------------------------------------------------------
# Auth — JWT (access corto + refresh) + argon2
# -----------------------------------------------------------------------------
# GENERA secretos fuertes y ÚNICOS por entorno. Ejemplo: `openssl rand -hex 48`.
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_different_secret_from_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# -----------------------------------------------------------------------------
# Login con Google (v1.2) — verificación del ID token en el backend.
# El backend valida firma (JWKS de Google), `iss` de Google y, crucialmente,
# `aud === GOOGLE_CLIENT_ID`. Si GOOGLE_CLIENT_ID falta, el backend NO acepta el
# token a ciegas: rechaza el login con Google (auth email/password sigue OK).
# Es el MISMO Client ID (OAuth 2.0) que el frontend usa en NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Créalo en Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Seed inicial de cuentas administrativas (super_admin + vault_operator).
# SEC-C1 — NO hay defaults débiles aquí: genera contraseñas FUERTES y ÚNICAS por
# entorno ANTES de correr ./scripts/seed.sh. Ejemplo:  openssl rand -base64 24
#
#   AVISO (rol backend): hoy backend/prisma/seed.ts todavía cae a fallbacks
#   débiles si estas quedan vacías (super_admin -> 'ChangeMe123!') y el
#   vault_operator está HARDCODEADO a 'Operador123!' sin leer env. SEC-C1 exige
#   que backend elimine esos fallbacks y lea SEED_ADMIN_PASSWORD /
#   SEED_OPERATOR_PASSWORD como OBLIGATORIAS. Mientras backend lo cablea: define
#   estas variables y ROTA ambas credenciales tras el primer login. NUNCA
#   arranques un entorno accesible con los defaults del seed.
# -----------------------------------------------------------------------------
# super_admin del negocio:
SEED_ADMIN_EMAIL=
# OBLIGATORIO, generar fuerte (vacío = backend cae a default débil, no apto prod):
SEED_ADMIN_PASSWORD=
# vault_operator (rol de bóveda, menor confianza). Email opcional (default en seed):
SEED_OPERATOR_EMAIL=
# OBLIGATORIO, generar fuerte. Backend debe leerla (SEC-C1); ver AVISO arriba:
SEED_OPERATOR_PASSWORD=

# -----------------------------------------------------------------------------
# Cifrado de PII en reposo (CLABE/RFC) + blind index para match sin descifrar.
# Endurecimiento PII (rol backend). Estas DOS llaves las lee el backend:
#   * PII_ENCRYPTION_KEY -> AES-256-GCM para cifrar CLABE/RFC en la BD.
#   * PII_HMAC_KEY       -> HMAC del blind index de CLABE (buscar/deduplicar
#                           sin descifrar). DEBE ser DISTINTA de la de cifrado.
# En LOCAL puedes dejarlas vacías (greenfield sin datos); en NO-LOCAL
# (staging/prod) son OBLIGATORIAS: el backend debe abortar si faltan.
# En PROD gestiónalas por KMS / secret manager (no en un .env versionado).
# -----------------------------------------------------------------------------
# clave AES-256 para cifrar PII (CLABE/RFC) en reposo; generar con `openssl rand -base64 32`; en prod gestionar por KMS/secret manager; OBLIGATORIA en no-local
PII_ENCRYPTION_KEY=
# clave HMAC para el blind index de CLABE (match sin descifrar); generar con `openssl rand -base64 32`; distinta de PII_ENCRYPTION_KEY; OBLIGATORIA en no-local
PII_HMAC_KEY=

# -----------------------------------------------------------------------------
# Stripe (pagos: checkout, PaymentIntents, webhooks)
# -----------------------------------------------------------------------------
# Claves de tu dashboard de Stripe (usa claves de TEST en desarrollo: sk_test_ / pk_test_).
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
# Secreto de firma del endpoint de webhooks. En local se obtiene con:
#   stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# -----------------------------------------------------------------------------
# Disputas (v1.2) — correo de contacto para enviar evidencia de disputa.
# La evidencia de disputa YA NO se sube al bucket (ver Object storage): el backend
# devuelve este correo como `evidenceContact` para que el cliente envíe la evidencia
# por email. Overridable por env sin redeploy; si se deja vacío, el backend cae a su
# default `soporte@tcgvaultmx.com` (backend/src/modules/disputes/disputes.constants.ts).
# -----------------------------------------------------------------------------
DISPUTE_EVIDENCE_CONTACT=soporte@tcgvaultmx.com

# -----------------------------------------------------------------------------
# APIs de precios. Proveedor del INGEST intercambiable por el dial PRICE_PROVIDER
# (ver bloque siguiente). Dos superficies distintas:
#   * INGEST MASIVO del catálogo (WS-A, v1.14, §4.15): job `price-ingest`, proveedor
#     de PAGA por bulk endpoint (PokemonPriceTracker). Es el pricing PRIMARIO.
#   * Refresco per-carta de bóveda + stubs graded/sealed (free tier) — se conserva.
# Solo se prician cartas EN bóveda / catálogo + cache diario para el rate-limit.
# -----------------------------------------------------------------------------
# pokemontcg.io — raw/singles (TCGPlayer "Market Price"), metadata del catálogo y
# proveedor LEGACY/alterno del ingest (PRICE_PROVIDER=pokemontcg_io = rollback).
# API key gratis en dev.pokemontcg.io (con key ~20k req/día). Requerido en prod.
POKEMONTCG_IO_API_KEY=CHANGE_ME
# PokemonPriceTracker — proveedor de PAGA del INGEST MASIVO (WS-A, §4.15): bulk
# endpoint POST /api/v1/cards/bulk-price, auth `Authorization: Bearer <esta key>`.
# Es la fuente PRIMARIA del pricing del catálogo cuando PRICE_PROVIDER=pokemonpricetracker.
#   * REQUISITO OPERATIVO en prod cuando el dial apunta al proveedor de paga: la key
#     debe tener CUOTA del PLAN DE PAGA (el ingest baja el catálogo por set, 1–2×/día).
#     Sin key / key inválida el ingest NO borra precios (los deja STALE, money-safe) y
#     alerta; NO hay fallback silencioso a otra fuente.
#   * EL VALOR VA EN RAILWAY (ya aprovisionado), NUNCA en el repo. Aquí solo el
#     placeholder; el código solo lee process.env. gitleaks vigila fugas.
#   * Rol residual free-tier: stub graded/sealed per-carta (BE-6), cubierto por
#     override manual del admin. Ver DEVOPS_NOTES §19.
POKEMONPRICETRACKER_API_KEY=CHANGE_ME
# PokemonPriceTracker — MONEDA + UNIDAD del campo `market` del proveedor de PAGA (WS-A §36.2).
# CANDADO MONEY-SAFE (fail-closed): SIN esta env el proveedor de paga corre en modo SAMPLE-ONLY
# (hace el fetch, LOGUEA una muestra de la 1ª entrada cruda, pero NO PERSISTE ni un solo precio →
# `rows: []`). El DEFAULT SEGURO es dejarla VACÍA: así, aunque se flipee el dial PRICE_PROVIDER a
# pokemonpricetracker, el proveedor NO escribe precios bajo una moneda/unidad ASUMIDA (evita inflar
# ~18×/100× la referencia). Valores válidos (elige según el LOG de muestra, no a ciegas):
#   usd_dollars -> USD en dólares  (×100 a centavos + FX USD→MXN + colchón)  <-- CONFIRMADO POR EL PO
#   usd_cents   -> USD en centavos (sin ×100 + FX USD→MXN + colchón)
#   mxn_dollars -> MXN en pesos    (×100 a centavos, SIN FX)
#   mxn_cents   -> MXN en centavos (sin ×100, SIN FX)
# PROCEDIMIENTO OBLIGATORIO (DEVOPS_NOTES §19.5): con el dial PRICE_PROVIDER en pokemonpricetracker,
# corre POST /api/v1/admin/jobs/price-ingest { "setId": "sv8" } (sample-only), LEE el log de muestra
# de esa corrida y SOLO entonces fija el valor. El PO confirmó (2026-08-17) que el proveedor entrega
# USD en DÓLARES -> fijar `usd_dollars`. Déjala VACÍA hasta verificar el log en Railway.
POKEMONPRICETRACKER_MARKET_FORMAT=
# PokeTrace — respaldo per-carta para gradeadas/sellado. Free tier ~250/día (stub BE-6).
POKETRACE_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Dial PRICE_PROVIDER (price_provider) — NO ES ENV: es un ConfigSetting (M10/M2),
# editable SIN redeploy desde el PANEL de admin. Selecciona el proveedor del INGEST
# MASIVO (`price-ingest`, WS-A §4.15h). Se documenta aquí para no confundirlo con
# una variable de entorno. Valores:
#   pokemontcg_io        -> LEGACY (usa POKEMONTCG_IO_API_KEY; sin coste de paga)
#   pokemonpricetracker  -> PAGA   (usa POKEMONPRICETRACKER_API_KEY; bulk)
# Seed money-safe = pokemontcg_io (sin cambio de fuente al desplegar; el job ya es
# robusto). devops flipea a pokemonpricetracker DESDE EL PANEL M10 tras verificar el
# esquema/moneda (USD vs MXN) en la 1ª corrida — runbook DEVOPS_NOTES §19.5.
# OJO (WS-A §36.2): flipear ESTE dial NO basta para que el proveedor de paga escriba —
# además hay que fijar POKEMONPRICETRACKER_MARKET_FORMAT (arriba); sin ella corre sample-only.
# ROLLBACK money-safe = volver a flipear a pokemontcg_io (sin redeploy).
# Como es un dial de negocio, NO se pone aquí ni en Railway; se cambia por API/panel.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Jobs programados — import de METADATA del catálogo `catalog-metadata-sync`
# (v1.14 WS-A — cierre 2026-08-17). Reemplaza en el schedule al barrido pesado
# `catalog-price-sync` (force:true), que quedó MANUAL/OPS-ONLY.
#
#   >>> WS-A (HECHO): el scheduler YA NO agenda `catalog-price-sync` (force:true,
#   >>> re-baja TODO el catálogo). El PRICING lo asume `price-ingest` 2×/día (ingest
#   >>> masivo por set; ver PRICE_INGEST_CRON_* abajo y DEVOPS_NOTES §19). Además,
#   >>> tras el aligeramiento de WS-A, `catalog-sync` YA NO escribe `PriceReference`
#   >>> ni convierte FX: es SOLO metadata (sets/cartas/imágenes).
#
# AGENDADO AHORA: `catalog-metadata-sync` DIARIO y barato (`syncAll force:false`):
# importa SOLO sets/cartas NUEVAS (salta los ya poblados). Overridable por
# CATALOG_METADATA_SYNC_CRON (abajo); el scheduler lo lee en scheduler.service.ts.
#
# MANUAL / OPS-ONLY: `catalog-price-sync` (force:true, re-sync completo de metadata) se
# dispara a mano con `POST /api/v1/admin/jobs/catalog-price-sync` (super_admin, auditado).
# YA NO se agenda por cron; úsalo para forzar un re-import puntual (p. ej. tras cargar la key).
#
# DEPRECADO — `CATALOG_PRICE_SYNC_CRON_1/_2`: el scheduler WS-A YA NO los lee (grep en
# backend/src = 0 usos). Fijarlos NO tiene efecto; se retiran de la plantilla. El pricing
# agendado es PRICE_INGEST_CRON_*; el metadata agendado es CATALOG_METADATA_SYNC_CRON.
#
# REQUISITOS OPERATIVOS (prod — ver DEVOPS_NOTES §18):
#   * REDIS_URL (arriba): sin Redis el scheduler NO programa NINGÚN cron (queda
#     deshabilitado con un warning); el job solo sería disparable a mano.
#   * POKEMONTCG_IO_API_KEY (abajo): el import consulta pokemontcg.io. El free tier
#     autenticado (~20k req/día) es holgado para un import diario de solo sets nuevos.
# NO pongas el valor a cadena VACÍA para "apagar": el código usa `?? default` (solo cubre
# variable ausente); "" produce un patrón de cron INVÁLIDO. Para deshabilitar sin tocar
# código, usa un cron válido que nunca dispare (DEVOPS_NOTES §18.7 rollback).
# -----------------------------------------------------------------------------
# Cron (UTC) del import diario de metadata — default 01:00 UTC = 19:00 CDMX (barato: solo sets nuevos):
CATALOG_METADATA_SYNC_CRON=0 1 * * *

# -----------------------------------------------------------------------------
# Jobs programados — INGEST MASIVO de precios `price-ingest` (WS-A, v1.14, §4.15).
# ES EL PRICING PRIMARIO del catálogo (reemplaza el rol de `catalog-price-sync`
# de arriba). El job (parent `price-ingest` + child `price-ingest-set`, uno por
# set) baja precios del proveedor seleccionado por el dial PRICE_PROVIDER y hace
# upsert idempotente de `PriceReference` por (carta, acabado, día). Robusto y
# reanudable (cola en Redis, un job BullMQ por set). Horario de negocio: **06:00 y
# 18:00 CDMX** (mismo slot 2×/día que reemplaza). Crons en **UTC**.
#
#   CDMX = UTC−6 (fijo, sin horario de verano). Para pasar de CDMX a UTC SUMA 6 h:
#       06:00 CDMX = 12:00 UTC   → cron "0 12 * * *"
#       18:00 CDMX = 00:00 UTC   → cron "0 0  * * *"
#   ORDEN CON FX (requisito): `fx-refresh` (00:00 CDMX = 06:00 UTC, hardcodeado en
#   backend) corre ANTES de ambas corridas → el ingest convierte USD→MXN con el FX
#   del día (colchón #13 incluido). Mantén price-ingest DESPUÉS de fx-refresh.
#
# REQUISITOS OPERATIVOS (obligatorios en prod — ver DEVOPS_NOTES §19):
#   * REDIS_URL (arriba): sin Redis NO se programa el cron (solo disparo manual
#     awaited). La cola persistida en Redis es lo que hace el job reanudable.
#   * Proveedor: si PRICE_PROVIDER=pokemonpricetracker → POKEMONPRICETRACKER_API_KEY
#     con CUOTA del plan de paga. Si =pokemontcg_io (legacy/rollback) →
#     POKEMONTCG_IO_API_KEY. Sin key válida el ingest deja precios STALE (no borra).
#
# WIRING HECHO (BACKEND, WS-A cierre 2026-08-17): el scheduler LEE PRICE_INGEST_CRON_1/_2 y
# programa `price-ingest` POR DEFECTO 2×/día (ya NO es opt-in) con el dial SEMBRADO
# `pokemontcg_io` (legacy USD, money-safe; NO activa el proveedor de paga). En un deploy CON
# Redis (Railway) los precios se refrescan desde el arranque sin config manual. Defaults
# `0 0 * * *` / `0 12 * * *`. NO uses cadena VACÍA para apagar (cron inválido; ver §19.7 rollback).
# -----------------------------------------------------------------------------
# Cron (UTC) del ingest #1 — default 00:00 UTC = 18:00 CDMX (corrida de la TARDE):
PRICE_INGEST_CRON_1=0 0 * * *
# Cron (UTC) del ingest #2 — default 12:00 UTC = 06:00 CDMX (corrida de la MAÑANA):
PRICE_INGEST_CRON_2=0 12 * * *

# -----------------------------------------------------------------------------
# Gráfica pública del "set destacado" del hero (v1.9-set-chart). Ver
# ARCHITECTURE §4.12 y API_CONTRACT (GET /catalog/featured-set/value-history).
# -----------------------------------------------------------------------------
# ID NATIVO de pokemontcg.io del set que se grafica en la home (mismo id que se
# pasa a POST /admin/catalog/sync {setId} y que consumen los jobs diarios
# `set-price-sync` + `set-value-snapshot`). Es un id de CATÁLOGO público (no PII,
# no secreto). El backend resuelve el set destacado en cascada:
#   1) HOME_FEATURED_SET_ID (si está y existe un CardSet local con ese externalId),
#   2) fallback: set con mayor valor en su último SetValueSnapshot,
#   3) fallback: CardSet con releaseDate más reciente,
#   4) si no hay ningún set: el endpoint responde set:null, points:[] (hero degrada).
# El host pokemontcg.io es FIJO en el cliente (anti-SSRF) y el setId se valida
# contra ^[a-z0-9]+(-[a-z0-9]+)*$ — por eso aquí va SOLO el id, nunca una URL.
# Ejemplo REAL (id nativo pokemontcg.io): sv8pt5 = "Prismatic Evolutions"
# (serie Scarlet & Violet, releaseDate 2025-01-17) — set SV de altísimo interés
# y valor. Alternativa: sv8 = "Surging Sparks" (2024-11-08). En local puede ir
# vacío (caen los fallbacks). En prod, fíjalo en Railway al set que quieras destacar.
HOME_FEATURED_SET_ID=sv8pt5
# NOTA: POKEMONTCG_IO_API_KEY (arriba) es RECOMENDADO en prod para esta gráfica:
# `set-price-sync` precia el SET COMPLETO (~150-250 cartas) desde pokemontcg.io;
# sin API key el free tier sin autenticar tiene un rate-limit más estricto y el
# preciado del set puede tardar/estrangularse. Con la key, el set entra holgado.

# -----------------------------------------------------------------------------
# Object storage S3-compatible — ÚNICO USO en v1.2: la INE del KYC del buylist
# (prefijo kyc_ine/). Local = MinIO (docker-compose). Prod = Cloudflare R2 o AWS S3.
# La app SUBE la INE con URL prefirmada (presigned PUT) y se descarga por
# presigned GET de vida corta (lo implementa backend). El bucket se mantiene
# porque sigue siendo necesario para custodiar la INE cifrada + retención
# (INE_RETENTION_DAYS).
#
# v1.2.1 — SIMPLIFICACIÓN: ya NO hay fotos de producto/inventario (`inventory_photo`)
# ni CDN público del catálogo, ni evidencia de disputa en el bucket (`dispute_claim`).
# El backend solo admite `purpose="kyc_ine"` en el presign (cualquier otro → 422).
# Por eso ya NO existe S3_PUBLIC_BASE_URL (no hay prefijo público que servir).
#
# SEC-A5 — BUCKET PRIVADO (custodia de INE/KYC/PII):
#   * En PROD (R2/S3) el bucket NO debe tener lectura pública anónima. El prefijo
#     kyc_ine/ contiene INE/PII y se sirve SOLO por presigned GET de vida corta.
#   * CORS del bucket: SOLO el dominio del frontend (APP_BASE_URL), métodos
#     PUT (subida presignada) y GET (descarga presignada). Prohibido origin '*'.
#   * En LOCAL (MinIO) el init container 'createbuckets' deja el bucket PRIVADO;
#     kyc_ine/ nunca tiene lectura anónima. Detalle en docker-compose.yml.
# -----------------------------------------------------------------------------
# MinIO root (local ok — coinciden con docker-compose.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local_dev
# Config S3 que consume el backend (solo kyc_ine). Local apunta a MinIO:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tcg-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_local_dev
# Fuerza path-style addressing (necesario con MinIO). En AWS/R2 puede ir en false.
S3_FORCE_PATH_STYLE=true
# Tope de tamaño (BYTES) del upload presignado de la INE (kyc_ine). OPCIONAL: si se
# deja vacío, el backend usa 10 MiB (10485760) por defecto. El límite se FIJA en la
# firma (ContentLength), así que un PUT que exceda el tope es rechazado por S3/MinIO/R2.
KYC_UPLOAD_MAX_BYTES=10485760
# Retención de las INE del KYC (prefijo kyc_ine/). Días tras los que la INE deja
# de conservarse. El BORRADO efectivo lo hace el backend (job de retención); esta
# variable alimenta además una regla de LIFECYCLE del bucket (MinIO local/staging;
# R2/S3 en prod) como CAPA EXTRA de retención, por si el borrado del backend falla.
# La fuente de verdad de negocio puede ser un dial de M10 (ConfigSetting): si es
# así, mantén este número IGUAL al dial. Valor legal/fiscal — FIJADO en 180 días
# por decisión del negocio, alineado con el dial M10 del backend (fuente de verdad).
INE_RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# Tipo de cambio USD→MXN (FX). El colchón (bufferPct) es un dial de M10.
# ARCHITECTURE Decisión 5 (RESUELTA): fuente = Banxico (SIE) automático +
# colchón + override manual del admin (M10) como prioridad/fallback.
# -----------------------------------------------------------------------------
# banxico | manual  (decisión: banxico automático con override manual en M10)
FX_SOURCE=banxico
# Compat: el backend lee BANXICO_SIE_TOKEN y, si falta, cae a FX_API_KEY.
FX_API_KEY=
# Token de la API SIE de Banxico para el refresco automático de FX (USD→MXN).
# GRATIS en el portal SIE de Banxico. Si se deja vacío, el sistema cae a override
# manual (dial M10) / último FxRate conocido — el sistema NO se rompe.
BANXICO_SIE_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# Frontend (Next.js). Variables NEXT_PUBLIC_* se exponen al navegador:
# NO pongas secretos aquí, solo claves públicas.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
NEXT_PUBLIC_DEFAULT_LOCALE=es
# Login con Google (v1.2): Client ID OAuth 2.0 (público, se expone al navegador).
# DEBE ser el MISMO valor que GOOGLE_CLIENT_ID del backend (mismo OAuth client).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# Modo de datos del frontend: true = usa fixtures mock (desarrollo sin backend);
# false = llama al backend real en NEXT_PUBLIC_API_BASE_URL. Default sugerido en prod: false.
NEXT_PUBLIC_USE_MOCKS=false

# =============================================================================
# STAGING — entorno espejo aislado con datos SINTÉTICOS
# (docker-compose.staging.yml). Puertos desplazados para convivir con el local.
# NUNCA datos reales de clientes en staging. Los secretos de staging los provee
# el secret manager de la plataforma; en local caen a estos defaults.
# =============================================================================
# Puertos host del stack de staging (evitan choque con el compose local):
STAGING_POSTGRES_PORT=5433
STAGING_REDIS_PORT=6380
STAGING_MINIO_API_PORT=9010
STAGING_MINIO_CONSOLE_PORT=9011
STAGING_BACKEND_PORT=3011
STAGING_FRONTEND_PORT=3010
# Credenciales de la base/almacen de staging (separadas de dev y de prod):
STAGING_POSTGRES_USER=tcg_staging
STAGING_POSTGRES_PASSWORD=tcg_staging_password
STAGING_POSTGRES_DB=tcg_staging
STAGING_MINIO_ROOT_USER=minioadmin
STAGING_MINIO_ROOT_PASSWORD=minioadmin_staging
# En staging el backend corre en modo production (validaciones estrictas) pero
# con datos de prueba. Deja 'production' salvo que necesites relajarlo.
STAGING_NODE_ENV=production
# Secretos JWT de staging (distintos de dev y de prod). Genera con openssl rand -hex 48.
STAGING_JWT_ACCESS_SECRET=staging_access_secret_change_me
STAGING_JWT_REFRESH_SECRET=staging_refresh_secret_change_me
# Cifrado PII de staging (staging corre en modo production -> OBLIGATORIAS).
# Distintas entre sí y de las de prod. Genera con: openssl rand -base64 32.
STAGING_PII_ENCRYPTION_KEY=staging_pii_enc_key_change_me_32bytes
STAGING_PII_HMAC_KEY=staging_pii_hmac_key_change_me_distinct
# Cuentas sembradas en staging (datos SINTÉTICOS, aislado; nunca datos reales).
# Aun así, no reutilices estos valores en prod. Rota si el staging es accesible.
STAGING_SEED_ADMIN_EMAIL=admin@staging.local
STAGING_SEED_ADMIN_PASSWORD=StagingAdmin123!
STAGING_SEED_OPERATOR_EMAIL=operador@staging.local
STAGING_SEED_OPERATOR_PASSWORD=StagingOperator123!
# URLs internas del stack de staging (las usa el frontend/backend de staging):
STAGING_APP_BASE_URL=http://localhost:3010
STAGING_NEXT_PUBLIC_API_BASE_URL=http://localhost:3011/api/v1
# (v1.2.1: STAGING_S3_PUBLIC_BASE_URL eliminado — el bucket ya no tiene prefijo público)
# URL pública del staging desplegado (la usan los DAST en CI). En local puede ir vacío.
# En el staging real: https://staging.tudominio.com
STAGING_BASE_URL=

# -----------------------------------------------------------------------------
# [GH] Secrets de DEPLOY — SOLO en GitHub Secrets, NO en este .env (no van al repo
# ni al runtime de la app). Listados aquí solo como DOCUMENTACIÓN de lo que el
# pipeline .github/workflows/deploy.yml espera. Si falta alguno, el job
# `preflight` FALLA con la lista exacta (no despliega a medias).
#   RAILWAY_TOKEN       -> Railway: token de PROYECTO (Project Settings > Tokens)
#   VERCEL_TOKEN        -> Vercel: Account Settings > Tokens
#   VERCEL_ORG_ID       -> Vercel: aparece en frontend/.vercel/project.json tras `vercel link`
#   VERCEL_PROJECT_ID   -> idem
#   STAGING_BASE_URL    -> dominio estable de staging (front), objetivo del DAST
#   PROD_BASE_URL       -> dominio estable de producción (front)
# -----------------------------------------------------------------------------

# =============================================================================
# Stripe en modo TEST — para E2E y para staging (NUNCA claves live aquí)
# =============================================================================
STRIPE_TEST_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_TEST_WEBHOOK_SECRET=whsec_CHANGE_ME

# =============================================================================
# E2E y DAST (harness de seguridad y E2E en vivo)
# =============================================================================
# URL base contra la que corre la suite E2E del frontend (Playwright, etc.).
# Local con el stack de staging levantado: http://localhost:3010
E2E_BASE_URL=http://localhost:3010
# Objetivo de los escáneres DAST (ZAP / nuclei / nikto / sqlmap / ffuf).
# SIEMPRE staging, salvo prueba puntual autorizada (ver DEVOPS_NOTES › Runbook).
TARGET_URL=http://localhost:3010
# Salvaguarda: 1 permite DAST contra prod SOLO dentro de una ventana autorizada.
# Déjalo en 0 (o sin definir) en todo momento fuera de esa ventana.
ALLOW_PROD_DAST=0
