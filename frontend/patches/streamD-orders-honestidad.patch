+ * manual; real = fase 2). Req = `{}` (usa el BillingProfile en archivo).
+ */
+export async function requestOrderInvoice(orderId: string): Promise<RequestInvoiceResponse> {
+  if (!config.useMocks) {
+    return apiRequest<RequestInvoiceResponse>(`/orders/${orderId}/request-invoice`, {
+      method: 'POST',
+      body: {},
+    });
+  }
+  // MOCK: persiste en el fixture para que un refetch de getOrder siga reportando la solicitud
+  // (misma semántica que el backend real: la marca vive en la orden).
+  fx.mockOrderDetail.invoiceRequested = true;
+  return delay({ orderId, invoiceRequested: true, instructions: 'SEND_FISCAL_DATA_BY_EMAIL' });
+}
